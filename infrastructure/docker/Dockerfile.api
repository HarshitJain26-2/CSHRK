FROM node:20-alpine AS builder

WORKDIR /app

# Copy root workspace configs
COPY package.json ./
COPY packages/ ./packages/
COPY services/api/ ./services/api/

# Install dependencies and build shared packages + API
RUN npm install
RUN npm run build --workspace=@cshrk/types
RUN npm run build --workspace=@cshrk/config
RUN npm run build --workspace=@cshrk/validation
RUN npm run build --workspace=@cshrk/api

FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000

COPY package.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/services/api/dist ./services/api/dist
COPY --from=builder /app/services/api/package.json ./services/api/package.json

EXPOSE 3000

CMD ["node", "services/api/dist/main"]
