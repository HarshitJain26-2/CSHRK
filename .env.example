# ==============================================================================
# CSHRK Environment Configuration Template
# Copy this file to .env and adjust variables for your local development setup
# NEVER commit real credentials, production secrets, or .env files to Git
# ==============================================================================

# General Environment
NODE_ENV=development
APP_NAME=CSHRK
PORT=3000

# Backend API Configuration
API_PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:19006,http://localhost:8081

# PostgreSQL + PostGIS Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=cshrk_db
DATABASE_SSL=false

# Authentication & JWT
JWT_SECRET=cshrk_dev_jwt_super_secret_key_change_in_production_32char
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=cshrk_dev_refresh_super_secret_key_change_in_production
JWT_REFRESH_EXPIRES_IN=30d

# AI Service (FastAPI)
AI_SERVICE_HOST=localhost
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://localhost:8000

# Frontend Web Application (Admin Web)
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Mobile Applications (Customer & Worker Expo)
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
